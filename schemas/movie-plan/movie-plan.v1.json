{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finstack.ai/schemas/movie-plan/v1",
  "title": "MoviePlanV1",
  "description": "Declarative MoviePlan v1: a bounded, resumable movie generation plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "scenes", "output"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "defaults": { "$ref": "#/$defs/plan_defaults" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene_spec" }
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/plan_transition" }
    },
    "audio": { "$ref": "#/$defs/plan_audio" },
    "output": { "$ref": "#/$defs/plan_output" }
  },
  "$defs": {
    "plan_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_model", "video_model", "scene_duration_s"],
      "properties": {
        "image_model": { "type": "string", "minLength": 1 },
        "video_model": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 },
        "aspect_ratio": { "type": "string", "minLength": 1 },
        "scene_duration_s": { "type": "integer", "minimum": 1 }
      }
    },
    "scene_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "video_prompt", "start_frame"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "video_prompt": { "type": "string", "minLength": 1 },
        "start_frame": { "$ref": "#/$defs/frame_source" },
        "end_frame": { "$ref": "#/$defs/frame_source" },
        "reference_images": {
          "type": "array",
          "items": { "$ref": "#/$defs/frame_source" }
        },
        "duration_s": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" },
        "captions": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/caption_cue" }
        },
        "overrides": { "$ref": "#/$defs/scene_overrides" }
      }
    },
    "caption_cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start_s", "end_s"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "start_s": { "type": "number" },
        "end_s": { "type": "number" }
      }
    },
    "scene_overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image_model": { "type": "string", "minLength": 1 },
        "video_model": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 }
      }
    },
    "frame_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt"],
          "properties": {
            "prompt": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact"],
          "properties": {
            "artifact": { "type": "object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "plan_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "type"],
      "properties": {
        "after": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["cut", "crossfade", "fade_to_black"] },
        "duration_s": { "type": "number" }
      }
    },
    "plan_audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "mode"],
      "properties": {
        "artifact": { "type": "object" },
        "mode": { "type": "string", "enum": ["replace", "mix"] }
      }
    },
    "plan_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container"],
      "properties": {
        "container": { "type": "string", "enum": ["mp4", "webm"] },
        "fps": { "type": "integer", "minimum": 1 },
        "captions": { "type": "string", "enum": ["none", "sidecar", "burn_in"] }
      }
    }
  }
}
