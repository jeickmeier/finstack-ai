              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "payload": {
                "description": "Opaque expected value retained by fixture harness; not a Phase-1 semantic type."
              },
              "payload_declaration": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "declared_envelope_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8388608
                  },
                  "declared_batch_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16777216
                  },
                  "declared_batch_records": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 256
                  },
                  "declared_string_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4194304
                  },
                  "declared_array_items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  },
                  "declared_map_entries": {
                    "type": "integer",
