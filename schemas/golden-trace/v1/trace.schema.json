        "final_state": {
          "description": "Opaque expected value retained by fixture harness; not a Phase-1 semantic type."
        },
        "final_result": {
          "description": "Opaque expected value retained by fixture harness; not a Phase-1 semantic type."
        },
        "state_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Expected semantic state hash; reducer-backed fixtures obtain it from KernelState::state_hash."
        }
