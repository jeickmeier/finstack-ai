                    "maximum": 1048576
                  },
                  "declared_metadata_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65536
                  }
                }
              }
            }
          }
        },
        "normalized_events": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "durability"
            ],
            "properties": {
              "kind": {
                "type": "string",
