{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finstack.ai/schemas/golden-trace/v1/scripted-input.schema.json",
  "title": "ScriptedInput",
  "description": "Deterministic scripted model/tool/timer outcomes for golden traces (PR-005; TDD \u00a732).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "steps"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "steps": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "model_chunk",
              "tool_call",
              "tool_result",
              "cancellation",
              "error",
              "timer"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "maxLength": 4194304
          },
          "tool_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          },
          "result": {},
          "error_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "payload_declaration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "declared_envelope_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              },
              "declared_batch_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "declared_batch_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              },
              "declared_string_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              },
              "declared_array_items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "declared_map_entries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              },
              "declared_nesting_depth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "declared_raw_json_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "declared_metadata_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65536
              }
            }
          }
        }
      }
    }
  }
}
