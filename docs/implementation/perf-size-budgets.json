{
  "format_version": 1,
  "workload": "size-budgets-v1",
  "artifacts": [
    {
      "id": "python-wheel",
      "path_glob": "target/wheels/finstack_ai-*.whl",
      "max_bytes": 10485760,
      "required": false
    },
    {
      "id": "wasm-bg",
      "path": "bindings/finstack-ai-wasm/js/generated/finstack_ai_wasm_bg.wasm",
      "max_bytes": 10223616,
      "max_gzip_bytes": 3014656,
      "required": true
    },
    {
      "id": "minimal-cli",
      "path": "target/release/minimal",
      "max_bytes": 9437184,
      "required": false
    }
  ]
}
